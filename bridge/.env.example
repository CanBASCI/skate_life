BRIDGE_PORT=8787

# --- YouTube (official Data API v3) ---
# Google Cloud → enable YouTube Data API v3 → create API key
# YOUTUBE_API_KEY=your_api_key
# Live video id from Studio / watch URL (v=… or youtu.be/…)
# YOUTUBE_VIDEO_ID=xxxxxxxxxxx
# Or paste chat id directly (skips videos.list):
# YOUTUBE_LIVE_CHAT_ID=
# Start YouTube poll when bridge boots:
# YOUTUBE_AUTO_START=1

# --- TikTok (no login; username of the live host) ---
# TIKTOK_USERNAME=your_tiktok_unique_id

# --- Instagram (pick ONE auth method) ---
# Preferred: browser session cookie (Application → Cookies → sessionid)
# IG_SESSION_ID=paste_sessionid_here
# Optional helper cookie:
# IG_DS_USER_ID=

# Or password login (higher ban / checkpoint risk):
# IG_USERNAME=
# IG_PASSWORD=

# If auto-detect fails while you are already live:
# IG_BROADCAST_ID=

# Start Instagram poll when bridge boots:
# IG_AUTO_START=1

# Meta official webhook (optional, needs public HTTPS + Meta app):
# IG_WEBHOOK_VERIFY_TOKEN=skate_life_ig_verify
